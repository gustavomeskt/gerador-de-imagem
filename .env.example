# Configuração do backend local (pasta server/).
# Copie este arquivo para ".env" na raiz do projeto e ajuste.
# O arquivo .env NUNCA vai para o repositório (está no .gitignore).

# --- Modo -------------------------------------------------------------
# simulated = o servidor NÃO chama a OpenAI e nada é cobrado (padrão).
# openai    = chamadas reais e PAGAS (sempre com confirmação de custo na tela).
IMAGE_BACKEND_MODE=simulated

# Chave da OpenAI — só é lida pelo servidor. Necessária apenas no modo openai.
# Crie em https://platform.openai.com/api-keys. Não coloque aspas.
OPENAI_API_KEY=

# --- Rede (somente este computador) ------------------------------------
# O servidor recusa iniciar em qualquer endereço que não seja local.
HOST=127.0.0.1
PORT=8787
# Origens do app que podem chamar o servidor (o Vite roda na 5173).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Modelos permitidos -------------------------------------------------
# Lista separada por vírgulas. Vazio = todos os modelos do catálogo:
# gpt-image-1.5, gpt-image-1, gpt-image-1-mini, dall-e-3, dall-e-2
ALLOWED_MODELS=

# --- Proteção contra consumo descontrolado -------------------------------
# Custo máximo estimado por geração (todas as imagens de um nó), em US$.
MAX_COST_PER_JOB_USD=2
# Orçamento diário estimado, em US$ (zera à meia-noite UTC).
DAILY_BUDGET_USD=5
# Máximo de imagens por dia.
DAILY_IMAGE_LIMIT=50
# Máximo de imagens por geração.
MAX_IMAGES_PER_JOB=10
# Chamadas pagas por minuto.
MAX_REQUESTS_PER_MINUTE=20
# Chamadas simultâneas à OpenAI e tamanho da fila de espera.
MAX_CONCURRENT_REQUESTS=2
MAX_QUEUED_REQUESTS=8
# Validade do orçamento confirmado, em segundos.
QUOTE_TTL_SECONDS=600

# --- Limites técnicos ----------------------------------------------------
# Tamanho máximo do corpo das requisições (bytes).
MAX_BODY_BYTES=131072
# Tempo máximo de espera pela OpenAI (ms).
OPENAI_IMAGE_TIMEOUT_MS=180000
OPENAI_TEXT_TIMEOUT_MS=60000

# --- Opcionais -----------------------------------------------------------
# Pasta onde o servidor guarda o consumo do dia (fica fora do repositório).
SERVER_DATA_DIR=server/.data
# JSON com preços corrigidos (mesmo formato de DEFAULT_PRICES em server/pricing.ts).
PRICE_TABLE_FILE=
